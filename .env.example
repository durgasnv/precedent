# Backend
PORT=5000
NODE_ENV=development
# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
DECISION_DB_PATH=./data/precedent.sqlite
# Optional legacy JSON file to import once when the SQLite database is empty.
DECISION_STORE_PATH=./data/decisions.json

# Cloud: https://api.hindsight.vectorize.io; local server: http://localhost:8888
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=
HINDSIGHT_BANK_ID=precedent-decisions
